{
  "name": "cipherchat-server",
  "version": "1.0.0",
  "description": "CipherChat backend server with Socket.IO and Redis",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:cluster": "pm2-runtime start ecosystem.config.cjs",
    "dev": "node --watch server.js",
    "lint": "eslint . --config ../eslint.config.js --report-unused-disable-directives --max-warnings 0",
    "audit:ci": "npm audit --audit-level=moderate"
  },
  "keywords": [
    "chat",
    "socket.io",
    "redis",
    "ephemeral"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.1",
    "cipherchat": "file:..",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "isomorphic-dompurify": "^3.18.0",
    "mime-types": "^3.0.2",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "redis": "^4.6.12",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/multer": "^2.0.0",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "tar": "^7.5.16"
  }
}
